---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Omicron — Write freely. Share universally.",
  description = "A federated blogging platform that belongs to everyone.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/sourceserif4-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-500.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
  </head>
  <body class="font-sans min-h-dvh">
    <slot />
  </body>
</html>
