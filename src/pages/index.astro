---
import { Image, getImage } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/landing/SiteHeader.svelte";
import Hero from "../components/landing/Hero.svelte";
import OurStory from "../components/landing/OurStory.svelte";
import Team from "../components/landing/Team.svelte";
import Features from "../components/landing/Features.svelte";
import Faq from "../components/landing/Faq.svelte";
import Contact from "../components/landing/Contact.svelte";
import SiteFooter from "../components/landing/SiteFooter.svelte";
import landing from "../assets/landing.png";
import writerRabbit from "../assets/writer_rabbit.png";
import faqArt from "../assets/FAQ.png";
import subhanGadirli from "../assets/team/subhan-gadirli.jpeg";
import yusifAliyev from "../assets/team/yusif-aliyev.png";
import olafLaitinen from "../assets/team/olaf-laitinen.jpg";
import nurayAliyeva from "../assets/team/nuray-aliyeva.jpg";
import rafigAziz from "../assets/team/rafig-aziz.jpg";

const rabbitImage = await getImage({
  src: writerRabbit,
  width: 720,
  format: "webp",
});

const faqImage = await getImage({
  src: faqArt,
  width: 720,
  format: "webp",
});

const [subhanImage, yusifImage, olafImage, nurayImage, rafigImage] =
  await Promise.all(
    [subhanGadirli, yusifAliyev, olafLaitinen, nurayAliyeva, rafigAziz].map(
      (src) => getImage({ src, width: 640, format: "webp" }),
    ),
  );

const team = [
  {
    name: "Subhan Gadirli",
    role: "Founder & Fullstack Developer",
    image: subhanImage,
    position: "50% 35%",
  },
  {
    name: "Yusif Aliyev",
    role: "Software Engineer",
    image: yusifImage,
    position: "50% 30%",
  },
  {
    name: "Olaf Yunus Laitinen Imanov",
    role: "Quality Assurance Engineer",
    image: olafImage,
    position: "50% 20%",
  },
  {
    name: "Nuray Aliyeva",
    role: "Penetration Tester",
    image: nurayImage,
    position: "50% 20%",
  },
  {
    name: "Rafig Aziz",
    role: "Quality Assurance Engineer",
    image: rafigImage,
    position: "50% 30%",
  },
];
---

<BaseLayout>
  <SiteHeader client:load />

  <!-- hero: full-height artwork panel -->
  <div
    class="relative isolate flex min-h-dvh w-full items-center overflow-hidden pt-16 dark:bg-[#0b0d12]"
  >
    <Image
      src={landing}
      alt=""
      widths={[768, 1280, 1536, 2048]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="pointer-events-none absolute inset-0 -z-10 h-full w-full object-cover object-[18%_top] select-none sm:object-[70%_center]"
    />
    <!-- dark-mode overlay: dims the artwork into a rich night scene -->
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 -z-10 bg-none transition-colors duration-500 dark:bg-[linear-gradient(180deg,rgba(8,10,16,0.66)_0%,rgba(8,10,16,0.58)_42%,rgba(11,13,18,0.94)_88%,#0b0d12_100%)]"
    >
    </div>
    <main class="relative z-10 w-full px-6 pb-16 sm:px-12 lg:pr-[6%] lg:pl-[7.5%]">
      <Hero />
    </main>
  </div>

  <!-- scrollable content -->
  <div class="bg-white transition-colors duration-500 dark:bg-[#0b0d12]">
    <OurStory image={rabbitImage} />
    <Team members={team} />
    <Features />
    <Faq client:load image={faqImage} />
    <Contact />
  </div>

  <SiteFooter />
</BaseLayout>
