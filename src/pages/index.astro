---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/landing/Hero.svelte";
import landing from "../assets/landing.png";
---

<BaseLayout>
  <div class="relative min-h-dvh w-full overflow-hidden">
    <Image
      src={landing}
      alt=""
      widths={[768, 1280, 1536, 2048]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="pointer-events-none absolute inset-0 -z-10 h-full w-full object-cover object-[18%_top] select-none sm:object-[70%_center]"
    />
    <main class="relative z-10 w-full px-6 pb-24 sm:px-12 lg:pl-[7.5%] lg:pr-[6%]">
      <Hero />
    </main>
  </div>
</BaseLayout>
